@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using Blogifier.Shared.Resources
@inject IStringLocalizer<Resource> _localizer

@{
    SnippetModel listModel = (SnippetModel)Model;
}

@*@model SnippetModel
*@

<div class="col-md-7">
    <button class="header-nav-button d-none d-md-block" title="Add Category" type="button" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-folder-plus" viewBox="0 0 16 16">
            <path d="m.5 3 .04.87a1.99 1.99 0 0 0-.342 1.311l.637 7A2 2 0 0 0 2.826 14H9v-1H2.826a1 1 0 0 1-.995-.91l-.637-7A1 1 0 0 1 2.19 4h11.62a1 1 0 0 1 .996 1.09L14.54 8h1.005l.256-2.819A2 2 0 0 0 13.81 3H9.828a2 2 0 0 1-1.414-.586l-.828-.828A2 2 0 0 0 6.172 1H2.5a2 2 0 0 0-2 2zm5.672-1a1 1 0 0 1 .707.293L7.586 3H2.19c-.24 0-.47.042-.683.12L1.5 2.98a1 1 0 0 1 1-.98h3.672z" />
            <path d="M13.5 10a.5.5 0 0 1 .5.5V12h1.5a.5.5 0 1 1 0 1H14v1.5a.5.5 0 1 1-1 0V13h-1.5a.5.5 0 0 1 0-1H13v-1.5a.5.5 0 0 1 .5-.5z" />
        </svg>
    </button>
</div>

<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog mt-5">
        <div class="modal-content">
            <form id="categoryForm" asp-controller="Home" asp-action="AddCategory" method="post" class="modal-edit">
                @RenderCategories(listModel.Categories)
                <input type="text" id="categoryFormTitleInput" name="title" class="form-control form-control-lg popup-input" placeholder="Category Name ..." autocomplete="off" autofocus>
                <input type="submit" name="submit_button" class="btn btn-primary headspace" value="Save">
            </form>
        </div>
    </div>
</div>
@functions {

    IHtmlContent RenderCategories(IEnumerable<SnippetCategoryItem> categories)
    {
        var sortedListOfCategories = new SortedList<string, SnippetCategoryItem>();
        if (categories != null && categories.Any())
        {
            var listOfCategories = new List<SnippetCategoryItem>();

            foreach (var category in categories)
            {
                listOfCategories.AddRange(GetSubCategories(category));
            }

            foreach (var subCategory in listOfCategories)
            {
                sortedListOfCategories.Add(subCategory.Title, subCategory);
            }
        }

        var select = "<select title=\"Category\" asp-for=\"parentId\" name=\"parentId\" class=\"form-select form-select-lg mb-3 form-control-lg popup-input\">";
        select += "<option value=\"-1\">Select a parent category</option>";

        if (sortedListOfCategories.Any())
        {
            foreach (var sortedCategory in sortedListOfCategories.Values)
            {
                select += $"<option value=\"{sortedCategory.Id.ToString()}\">{sortedCategory.Title}</option>";
            }
        }

        select += "</select>";
        return Html.Raw(select);
    }

    IEnumerable<SnippetCategoryItem> GetSubCategories(SnippetCategoryItem category)
    {
        var retVal = new List<SnippetCategoryItem> { category };
        if (category.SubCategories == null || !category.SubCategories.Any()) return retVal;
        foreach (var categorySubCategory in category.SubCategories)
        {
            retVal.AddRange(GetSubCategories(categorySubCategory));
        }

        return retVal;
    }
}
