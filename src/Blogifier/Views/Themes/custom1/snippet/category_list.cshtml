@using Microsoft.AspNetCore.Html
@using Microsoft.Extensions.Localization
@using Blogifier.Shared.Resources
@inject IStringLocalizer<Resource> _localizer

@{
    SnippetModel listModel = (SnippetModel)Model;
}


@if (listModel.Categories.Any())
{
    <ul>
        @foreach (var category in listModel.Categories)
        {
            @RenderCategory(category);
        }
    </ul>
}
else
{
    <div class="h1 text-capitalize">@_localizer["empty"]!</div>
}

@functions {

    IHtmlContent RenderCategory(SnippetCategoryItem snippetCategory)
    {
        var snippetsUrl = Url.Content("~/snippets");
        var listItem = snippetCategory.SubCategories.Any() ?
            $"<li data-type=\"category\" class=\"category collapsed\" data-bs-toggle=\"collapse\" data-bs-target=\"#category{snippetCategory.Id}\"><span>{snippetCategory.Title}</span></li>" :
            $"<li data-type=\"category-empty\" data-bs-toggle=\"collapse\" data-bs-target=\"#category{snippetCategory.Id}\"><span>{snippetCategory.Title}</span></li>";

        var categorySnippets = string.Empty;

        if (snippetCategory.Snippets.Any())
        {
            //categorySnippets = snippetCategory.Snippets.Aggregate(categorySnippets, (current, snippet) => current + $"<li data-type=\"snippet\"><span>{snippet.Title}</span></li>");
            // <a class="post-nav-item text-start" href="~/posts/@_model.Older.Slug" aria-label="@_localizer["Previous post"]">
            //<span class="post-nav-text">@_localizer["Previous post"]</span>
            //<h4 class="post-nav-title">@_model.Older.Title</h4>
            // </a>
            foreach (var snippet in snippetCategory.Snippets)
            {
                categorySnippets += $"<li data-type=\"snippet\"><a href=\"{snippetsUrl}/{snippet.Id}\"><span>{snippet.Title}</span></a></li>";
            }
        }

        var subCategories = string.Empty;
        
        if(snippetCategory.SubCategories.Any())
        {
            subCategories = $"<ul class=\"sub-category collapse\" id=\"category{snippetCategory.Id}\">";

            foreach(var subCategory in snippetCategory.SubCategories)
            {
                subCategories += RenderCategory(subCategory);
            }
            subCategories += "</ul>";
        }
        return Html.Raw(listItem + categorySnippets + subCategories);
    }
}


